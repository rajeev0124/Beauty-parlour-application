# ============================================
# BEAUTY PARLOUR APPLICATION - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Create a free MongoDB Atlas account at: https://cloud.mongodb.com
# 1. Create a cluster (free tier)
# 2. Create a database user (Database Access)
# 3. Add your IP or 0.0.0.0/0 (Network Access)
# 4. Get connection string and paste below

MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/beauty-parlour?retryWrites=true&w=majority

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate your own secrets (any random string)
# Example: openssl rand -base64 32

JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200,https://your-vercel-app.vercel.app

# ============================================
# EMAIL/SMTP CONFIGURATION
# ============================================
# For Gmail: Use an "App Password" (not your regular password)
# 1. Go to Google Account > Security > 2-Step Verification
# 2. At the bottom, click "App passwords"
# 3. Generate a new app password for "Mail"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Beauty Parlour <your-email@gmail.com>
